# Environment file for development

# Database settings
POSTGRES_URL_PATH=postgres:123456@localhost:5432/ai-database
POSTGRES_SCHEMA=schedulerservice
DEBUG_SQLALCHEMY=false

# AI Service settings
AI_SERVICE_URL=http://localhost:8001

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG_SERVER=false

# Logging settings
LOG_LEVEL=INFO

# Scheduler settings
SCHEDULER_TIMEZONE=UTC
MAX_CONCURRENT_JOBS=10

# Job execution settings
JOB_TIMEOUT=300
MAX_RETRIES=3

# API settings
API_V1_PREFIX=/api/v1
