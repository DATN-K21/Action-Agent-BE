# Ingest Service Environment Configuration

# Debug mode
DEBUG_MODE=True

# Logging
LOGGING_LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=<YOUR-API-KEY>
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Vectorstore settings
PGVECTOR_POSTGRES_HOST=localhost
PGVECTOR_POSTGRES_PORT=5433
PGVECTOR_POSTGRES_USER=postgres
PGVECTOR_POSTGRES_PASSWORD=123456
PGVECTOR_POSTGRES_DB=ai-database
PGVECTOR_POSTGRES_SCHEMA=ingestservice
PGVECTOR_COLLECTION=documents

# Upload settings
MAX_UPLOAD_SIZE=52428800  # 50 MB

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=<your-connection-string>
AZURE_BLOB_CONTAINER_NAME=documentsdev

# RabbitMQ settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=root
RABBITMQ_PASSWORD=root
RABBITMQ_VHOST=/
RABBITMQ_SSL=False

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=default
REDIS_PASSWORD=default
REDIS_SSL=False

# AI Service API
AI_SERVICE_URL=http://localhost:15200

# Processors
MAX_WORKERS=1
