{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoSettings": {
    "ConnectionString": "mongodb://root:root@localhost:27017/user-service?authSource=admin",
    "DatabaseName": "user-service",
    "UserCollectionName": "Users",
    "PaymentCollectionName": "Payments"
  },
  "StripeSettings": {
    "WebhookSecret": "<your-stripe-webhook-secret>",
    "SecretKey": "<your-stripe-secret-key>",
    "Currency": "usd"
  },
  "RateSettings": {
    "CreditsPerUsd": 1000000
  }
}