# Debug modes
DEBUG_AGENT=False
DEBUG_SERVER=False
DEBUG_SQLALCHEMY=False

# Logging
LOGGING_LOG_LEVEL=INFO

# User Agent for web requests
USER_AGENT=Action-LLM-AI-Service/1.0 (Educational Project)

# Tools
TOOL_TAVILY_API_KEY=<your-tavily-api-key>

# Settings for LLM
OPENAI_PROVIDER=openai
ANTHROPIC_PROVIDER=anthropic

LLM_BASIC_MODEL=gpt-4o-mini
BASIC_MODEL_TEMPERATURE=0.5
BASIC_MODEL_CONTEXT_RATIO=0.2

LLM_REASONING_MODEL=claude-3-5-haiku-20241022
REASONING_MODEL_TEMPERATURE=0
REASONING_MODEL_CONTEXT_RATIO=0.1

LLM_VISION_MODEL=gpt-4o-mini
VISION_MODEL_TEMPERATURE=0.5
VISION_MODEL_CONTEXT_RATIO=0.2

# Suggestion service LLM settings
LLM_SUGGESTION_MODEL=gpt-4.1-mini
SUGGESTION_MODEL_TEMPERATURE=0.3
SUGGESTION_MODEL_MAX_TOKENS=5000

# OpenAI API settings
OPENAI_API_KEY=<YOUR-API-KEY>
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Anthropic API settings
ANTHROPIC_API_KEY=<YOUR-API-KEY>
ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# Default context settings
DEFAULT_CONTEXT_LIMIT=100000
DEFAULT_CONTEXT_RATIO=0.2

# Embedding
EMBEDDING_PROVIDER=openai

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=ai-database

# Composio
COMPOSIO_LOGGING_LEVEL=debug
COMPOSIO_API_KEY=<your-api-key>
COMPOSIO_REDIRECT_URL=http://localhost:15200/callback/extension

# Frontend redirect URL
FRONTEND_REDIRECT_URL=http://localhost:3000/callback/extension

# Security keys
SECRET_KEY=<secret-key>
MODEL_PROVIDER_ENCRYPTION_KEY=<encryption-key>

# VectorStore
PGVECTOR_COLLECTION=<collection-name>

# Graph settings
RECURSION_LIMIT=25

# Upload settings
# Max upload size: 50 MB
MAX_UPLOAD_SIZE=50000000

# Memory and Cache settings
SYSTEM_MEMORY_THRESHOLD=92.0
CACHE_MEMORY_THRESHOLD=0.92
CACHE_STARTUP_GRACE_PERIOD=60.0
CACHE_CLEANUP_RATIO=0.2
CACHE_ENABLE_MEMORY_LOGGING=True
CACHE_DETAILED_LOGGING_INTERVAL=300.0
CACHE_MEMORY_CHECK_INTERVAL=120.0
CACHE_TTL_SECONDS=3600.0

# Cache for streaming connections
STREAMING_CONNECTIONS_CACHE_MAX_ENTRIES=1000
STREAMING_CONNECTIONS_CACHE_MAX_MEMORY_MB=64.0

# Cache for tools
TOOLS_CACHE_MAX_ENTRIES=1000
TOOLS_CACHE_MAX_MEMORY_MB=512.0

# Cache for extension services
EXTENSION_SERVICES_CACHE_MAX_ENTRIES=400
EXTENSION_SERVICES_CACHE_MAX_MEMORY_MB=256.0

# Sets the number of processors
MAX_WORKERS=1

# Settings for celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Embedding model. See the list of supported models: https://qdrant.github.io/fastembed/examples/Supported_Models/
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1
FASTEMBED_CACHE_PATH="./fastembed_cache"

# Extension service settings
EXTENSION_SERVICE_URL=http://localhost:15300

# Protected names
PROTECTED_NAMES=user,ignore,error
